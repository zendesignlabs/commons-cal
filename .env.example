# Production configuration for the bundled Docker Compose stack.
# Copy to .env, replace the domain, and generate the password as described in README.md.
PORT=4010
DEMO_MODE=false
PUBLIC_ORIGIN=https://calendar.example.org
ALLOW_CALENDAR_CREATION=true
MAX_CALENDARS=25
SIGNUP_RADICALE_URL=http://radicale:5232/commons-workspaces/
SIGNUP_RADICALE_USERNAME=commons-workspaces
SIGNUP_RADICALE_PASSWORD=
# Optional admin access. Generate a hash with scripts/hash-admin-password.mjs.
ADMIN_PASSWORD_HASH=
# Existing Radicale / static registry (see docs/configuration.md):
# CALENDARS_FILE=/config/calendars.json
# RADICALE_URL=https://caldav.example.org/community/events/
# RADICALE_USERNAME=community
# RADICALE_PASSWORD=
# ORGANIZER_TOKEN=
# CALENDAR_ID=community
# CALENDAR_NAME=Community Calendar
